{
  "name": "losslesscut-mcp",
  "version": "0.1.0",
  "description": "MCP integration for native LosslessCut editing workflows",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "check:toolchain": "node scripts/verify-toolchain.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:acceptance": "npm run build && node tests/integration/acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "json5": "2.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
